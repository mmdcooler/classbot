{
  "name": "ClassBot — 1. Bot",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message",
          "callback_query"
        ],
        "additionalFields": {}
      },
      "id": "138563f8-8f7e-4032-8736-f6261d9ffd46",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "ClassBot Telegram"
        }
      },
      "webhookId": "4ac58bbf-dd11-4c87-acc4-2144f68c5d94"
    },
    {
      "parameters": {
        "jsCode": "// Base64-encode the Telegram update so it can be passed to SQL safely (no SQL injection possible)\nreturn $input.all().map(i => ({ json: { b64: Buffer.from(JSON.stringify(i.json), 'utf8').toString('base64') } }));"
      },
      "id": "9d21c197-80bb-40fa-8e3d-3c64fc9b89fd",
      "name": "Encode update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT bot_handle(convert_from(decode('{{ $json.b64 }}', 'base64'), 'UTF8')::jsonb) AS actions;",
        "options": {
          "queryBatching": "independently"
        }
      },
      "id": "db5fb490-663e-4256-99c4-4c58286f55ae",
      "name": "Bot logic (SQL)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "ClassBot Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Each row carries a JSON array of Telegram actions -> one item per action\nconst out = [];\nfor (const item of $input.all()) {\n  const acts = item.json.actions || [];\n  for (const a of acts) out.push({ json: a });\n}\nreturn out;"
      },
      "id": "af6520ae-57ba-4fcd-9e45-79b2dec3e6e7",
      "name": "Split actions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Real Telegram API calls (internal actions start with \"_\")\nreturn $input.all()\n  .map((it, idx) => ({ json: it.json, binary: it.binary, pairedItem: { item: idx } }))\n  .filter(i => i.json.method && !i.json.method.startsWith('_'));"
      },
      "id": "3e92945d-1cd1-41f4-9af5-358452f0b61c",
      "name": "Telegram actions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.TELEGRAM_API_BASE || 'https://api.telegram.org') + '/bot' + $env.TELEGRAM_BOT_TOKEN + '/' + $json.method }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 40
            }
          },
          "timeout": 20000
        }
      },
      "id": "3736d1cc-b99d-446c-b0f1-45c6be4f3d25",
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        200
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "return $input.all()\n  .map((it, idx) => ({ json: it.json, binary: it.binary, pairedItem: { item: idx } }))\n  .filter(i => i.json.method === '_excel');"
      },
      "id": "de513492-92a9-418a-aa7e-de318ec086bf",
      "name": "Excel actions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        440
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT report_rows({{ parseInt($json.payload.assignment_id) }}) AS r, {{ parseInt($json.payload.chat_id) }}::bigint AS chat_id;",
        "options": {
          "queryBatching": "independently"
        }
      },
      "id": "5d4392b7-3bae-4bcb-a9e4-e6d8aa7bd666",
      "name": "Excel data",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1100,
        440
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "ClassBot Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// report_rows() -> one item per student with Persian column names (keeps column order)\nconst r = $input.first().json.r;\nif (!r.rows.length) return [{ json: { 'پیام': 'این کلاس هنوز دانشجویی ندارد' } }];\nreturn r.rows.map(row => {\n  const o = {};\n  r.columns.forEach((c, i) => { o[c] = row[i] === null || row[i] === undefined ? '' : row[i]; });\n  return { json: o };\n});"
      },
      "id": "7614afe0-3f9f-48b3-ae1d-99062f9d24dd",
      "name": "Rows to items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        440
      ]
    },
    {
      "parameters": {
        "operation": "xlsx",
        "binaryPropertyName": "data",
        "options": {
          "fileName": "={{ $('Excel data').first().json.r.file_name }}",
          "sheetName": "Report"
        }
      },
      "id": "0033a234-2cc4-4649-af59-5c9b6651b23c",
      "name": "Convert to Excel",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
        1540,
        440
      ]
    },
    {
      "parameters": {
        "operation": "sendDocument",
        "chatId": "={{ $('Excel data').first().json.chat_id }}",
        "binaryData": true,
        "binaryPropertyName": "data",
        "additionalFields": {
          "caption": "={{ $('Excel data').first().json.r.caption }}"
        }
      },
      "id": "fbf9c6ec-bcbb-4adf-a929-4d115e208c03",
      "name": "Send Excel",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
