{
  "name": "ClassBot — 1. Bot",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message",
          "callback_query"
        ],
        "additionalFields": {}
      },
      "id": "758b8f8c-2a1e-48de-b85d-8b3ecb7064e1",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "ClassBot Telegram"
        }
      },
      "webhookId": "9c5b6866-87b3-4728-82eb-7ef9758290fd"
    },
    {
      "parameters": {
        "jsCode": "// Base64-encode the Telegram update so it can be passed to SQL safely (no SQL injection possible)\nreturn $input.all().map(i => ({ json: { b64: Buffer.from(JSON.stringify(i.json), 'utf8').toString('base64') } }));"
      },
      "id": "42c2bda4-51e9-400d-af34-e4fa3488229f",
      "name": "Encode update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT bot_handle(convert_from(decode('{{ $json.b64 }}', 'base64'), 'UTF8')::jsonb) AS actions;",
        "options": {
          "queryBatching": "independently"
        }
      },
      "id": "e1e373e6-401b-4969-8115-1b9cf15aebf1",
      "name": "Bot logic (SQL)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "ClassBot Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Each row carries a JSON array of Telegram actions -> one item per action\nconst out = [];\nfor (const item of $input.all()) {\n  const acts = item.json.actions || [];\n  for (const a of acts) out.push({ json: a });\n}\nreturn out;"
      },
      "id": "becac29e-6c1e-44ef-a4d3-a386af8433f2",
      "name": "Split actions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Real Telegram API calls (internal actions start with \"_\")\nreturn $input.all()\n  .map((it, idx) => ({ json: it.json, binary: it.binary, pairedItem: { item: idx } }))\n  .filter(i => i.json.method && !i.json.method.startsWith('_'));"
      },
      "id": "4c19c53b-7508-4b6b-ab72-f3bf2a219fbc",
      "name": "Telegram actions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.TELEGRAM_API_BASE || 'https://api.telegram.org') + '/bot' + $env.TELEGRAM_BOT_TOKEN + '/' + $json.method }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 40
            }
          },
          "timeout": 20000
        }
      },
      "id": "ac167d41-3cd8-4503-b5bf-58abb6e73f97",
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        200
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "return $input.all()\n  .map((it, idx) => ({ json: it.json, binary: it.binary, pairedItem: { item: idx } }))\n  .filter(i => i.json.method === '_excel');"
      },
      "id": "53461dbe-ac5e-41ce-aac2-484efd44eb97",
      "name": "Excel actions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        440
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT report_rows({{ parseInt($json.payload.assignment_id) }}) AS r, {{ parseInt($json.payload.chat_id) }}::bigint AS chat_id;",
        "options": {
          "queryBatching": "independently"
        }
      },
      "id": "0699b3a9-3a61-4c9f-a9d6-2252ff02701f",
      "name": "Excel data",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1100,
        440
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "ClassBot Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// report_rows() -> one item per student with Persian column names (keeps column order)\nconst r = $input.first().json.r;\nif (!r.rows.length) return [{ json: { 'پیام': 'این کلاس هنوز دانشجویی ندارد' } }];\nreturn r.rows.map(row => {\n  const o = {};\n  r.columns.forEach((c, i) => { o[c] = row[i] === null || row[i] === undefined ? '' : row[i]; });\n  return { json: o };\n});"
      },
      "id": "94794c56-b235-4e94-9947-3e58fff13453",
      "name": "Rows to items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        440
      ]
    },
    {
      "parameters": {
        "operation": "xlsx",
        "binaryPropertyName": "data",
        "options": {
          "fileName": "={{ $('Excel data').first().json.r.file_name }}",
          "sheetName": "Report"
        }
      },
      "id": "7ea8b95d-3677-46a5-95e1-da151b5839ec",
      "name": "Convert to Excel",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
        1540,
        440
      ]
    },
    {
      "parameters": {
        "operation": "sendDocument",
        "chatId": "={{ $('Excel data').first().json.chat_id }}",
        "binaryData": true,
        "binaryPropertyName": "data",
        "additionalFields": {
          "caption": "={{ $('Excel data').first().json.r.caption }}"
        }
      },
      "id": "c674c1de-e5ab-4df3-a6d4-1bc9c10b4cf7",
      "name": "Send Excel",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
