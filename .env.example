# یک کپی با نام .env بسازید:  cp .env.example .env   و مقادیر را عوض کنید
N8N_DOMAIN=bot.example.com
N8N_VERSION=latest
# با دستور  openssl rand -hex 32  بسازید و هرگز عوضش نکنید (credentialها با آن رمز می‌شوند)
N8N_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

POSTGRES_USER=classbot
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=classbot
N8N_DB=n8n

# توکن ربات از @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...
